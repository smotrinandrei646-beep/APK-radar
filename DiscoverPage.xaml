<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VersionHunterX.DiscoverPage" Title="APK Радар" BackgroundColor="{StaticResource Bg}">
  <ScrollView>
    <VerticalStackLayout x:Name="Root" Padding="16" Spacing="14">
      <Border Padding="22" Background="{StaticResource Grad}" StrokeShape="RoundRectangle 26" StrokeThickness="0">
        <VerticalStackLayout Spacing="6">
          <Label Text="APK Радар" TextColor="White" FontSize="32" FontAttributes="Bold" />
          <Label Text="Свежие и старые версии из F-Droid, Aptoide, GitHub, GitLab и Codeberg. Только реальные APK, проверка SHA-256 и автоустановка." TextColor="#FFFFFFD9" FontSize="14" />
        </VerticalStackLayout>
      </Border>
      <Border BackgroundColor="{StaticResource Card}" StrokeShape="RoundRectangle 16" Stroke="#3B2166">
        <SearchBar x:Name="Bar" Placeholder="Что ищем?" TextColor="White" PlaceholderColor="#8B7FA8" SearchButtonPressed="OnSearch" />
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
